        "jsCode": "const rows=$input.all().map(i=>i.json);\nconst valid=rows.filter(r=>r.aprobado==='SI' && /^RP-0[1-7]$/.test(String(r.codigo)) && typeof r.contenido==='string' && r.contenido.trim());\nconst codes=valid.map(r=>r.codigo);\nconst valido=valid.length===7 && new Set(codes).size===7;\nconst texto=valido?valid.map(r=>`[${r.codigo}] ${r.tema}\\n${r.contenido}`).join('\\n\\n'):'';\nreturn [{json:{valido,texto,fuente:'Google Sheets / Base_comercial',version:'final-1.0',registros:valid.length}}];"
