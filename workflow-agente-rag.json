    {
      "parameters": {
        "jsCode": "const motivos=['revision_habitual','falta_informacion','excepcion'];\nlet r,validacion='correcta';\ntry {\n const v=typeof $json.output==='string'?JSON.parse($json.output.trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'')):$json.output;\n if(!v || v.estado!=='borrador' || v.requiere_revision!==true || typeof v.respuesta_sugerida!=='string' || !v.respuesta_sugerida.trim() || v.respuesta_sugerida.trim().split(/\\s+/).length>90 || !motivos.includes(v.motivo_revision) || !Array.isArray(v.fuentes) || v.fuentes.some(x=>!/^RP-0[1-7]$/.test(x))) throw Error('Formato');\n const steps=JSON.stringify($json.intermediateSteps??[]);\n if(v.fuentes.some(x=>!steps.includes(x)) || (v.motivo_revision==='revision_habitual' && v.fuentes.length===0)) throw Error('Sin evidencia');\n r={estado:'borrador',respuesta_sugerida:v.respuesta_sugerida.trim(),requiere_revision:true,motivo_revision:v.motivo_revision,fuentes:[...new Set(v.fuentes)]};\n if(/se pondr[aá] en contacto|te contactar[aá]|se comunicar[aá]|te escribir[aá]|te responder[aá]/i.test(r.respuesta_sugerida)){\n   r.respuesta_sugerida='Tu consulta requiere revisión de María antes de poder confirmar la información.';\n   r.fuentes=[];validacion='seguimiento_humano_no_confirmado';\n   if(r.motivo_revision==='revision_habitual')r.motivo_revision='falta_informacion';\n }\n} catch {validacion='fallback';r={estado:'borrador',respuesta_sugerida:'María debe revisar esta consulta antes de responder.',requiere_revision:true,motivo_revision:'falta_informacion',fuentes:[]};}\nreturn [{json:{...r,validacion}}];"
      },
